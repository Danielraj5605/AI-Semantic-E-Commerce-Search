# =============================================================================
# .env.example — copy this to .env and fill in your values
# This file is SAFE to commit. Never put real credentials here.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Neon.tech PostgreSQL with pgvector)
# Get your connection strings from: https://console.neon.tech
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require

# -----------------------------------------------------------------------------
# EMBEDDING MODEL (local, no API key required)
# Model is downloaded automatically from HuggingFace on first run.
# Options: all-MiniLM-L6-v2 (fast, 384-dim) | all-mpnet-base-v2 (slower, 768-dim)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# -----------------------------------------------------------------------------
# SEARCH SETTINGS (optional — defaults shown)
# -----------------------------------------------------------------------------
DEFAULT_SEARCH_LIMIT=20
MAX_SEARCH_LIMIT=100
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=512

# -----------------------------------------------------------------------------
# CORS (URL of the running frontend dev server)
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# LOCAL FALLBACK — set true to ignore DATABASE_URL* and use SQLite at
# backend/catalogue.db (no Postgres/pgvector needed). Then run the three
# scripts under "Database" in the README to populate it.
# -----------------------------------------------------------------------------
USE_LOCAL_DB=false
